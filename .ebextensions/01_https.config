packages:
  dnf:
    mod_ssl: []
    jq: []
    httpd: []

files:
  /etc/httpd/conf.d/ssl.conf:
    mode: "000644"
    owner: root
    group: root
    content: |
      LoadModule mpm_prefork_module modules/mod_mpm_prefork.so
      LoadModule ssl_module modules/mod_ssl.so
      LoadModule proxy_module modules/mod_proxy.so
      LoadModule proxy_http_module modules/mod_proxy_http.so
      
      Listen 443
      <VirtualHost *:443>
        ServerName api.xyz.in
        ServerAlias xyz.in
        DocumentRoot /var/app/current/
        
        SSLEngine             on
        SSLCertificateFile    "/etc/pki/tls/certs/server.crt"
        SSLCertificateKeyFile "/etc/pki/tls/certs/server.key"
        SSLCertificateChainFile "/etc/pki/tls/certs/chain.pem"
        
        ProxyPass / http://localhost:8080/
        ProxyPassReverse / http://localhost:8080/
        
        <Directory /var/app/current>
          AllowOverride All
          Require all granted
        </Directory>

        ErrorLog /var/log/httpd/ssl_error.log
        CustomLog /var/log/httpd/ssl_access.log combined
      </VirtualHost>

container_commands:
  01_check_cert:
    command: |
      if [ ! -f /etc/pki/tls/certs/server.crt ] || [ ! -f /etc/pki/tls/certs/server.key ]; then
        echo "Certificates not found, downloading..."
        mkdir -p /etc/pki/tls/certs
        aws acm get-certificate --certificate-arn arn:aws:acm:ap-south-1:590184025903:certificate/702ca26c-e230-4da7-81bb-531cff57e23d --region ap-south-1 > /tmp/cert.json
        
        cat /tmp/cert.json | jq -r '.Certificate' > /etc/pki/tls/certs/server.crt
        cat /tmp/cert.json | jq -r '.PrivateKey' > /etc/pki/tls/certs/server.key
        cat /tmp/cert.json | jq -r '.CertificateChain' > /etc/pki/tls/certs/chain.pem
        chmod 600 /etc/pki/tls/certs/server.key
        echo "Certificates installed" >> /var/log/eb-cert.log
      else
        echo "Certificates already exist, skipping download"
      fi

  02_verify_apache:
    command: |
      echo "Testing Apache configuration..."
      httpd -t >> /var/log/eb-cert.log 2>&1
      
  03_restart_apache:
    command: |
      echo "Restarting Apache..."
      systemctl restart httpd
      echo "Apache restarted" >> /var/log/eb-cert.log

After deploying, let's verify again:
```bash
# Check Apache status
sudo systemctl status httpd

# Check if Apache is listening on 443
sudo ss -tlnp | grep ':443'

# Check Apache error logs
sudo cat /var/log/httpd/error_log