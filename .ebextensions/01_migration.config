container_commands:
  00_check_env:
    command: |
      echo "Creating environment file..."
      # Use sudo to read the env file and create a properly formatted version
      sudo bash -c '
        while IFS="=" read -r key value; do
          echo "export $key=\"$value\""
        done < /opt/elasticbeanstalk/deployment/env > /tmp/eb_env.sh
      '
      sudo chmod 644 /tmp/eb_env.sh  # Make readable by all users
      echo "Environment file created:"
      cat /tmp/eb_env.sh
      
  01_prisma_migrate:
    command: |
      echo "Running migrations..."
      cd /var/app/current
      # Source the env file and run migration as webapp user
      sudo -u webapp bash -c 'source /tmp/eb_env.sh && npm run prisma:deploy'
    leader_only: true